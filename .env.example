# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

MONGODB_URI=mongodb://127.0.0.1:27017/universal_playlist_downloader

# Optional metadata API credentials. Keep all secrets server-side.
YOUTUBE_DATA_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Jamendo API client ID for licensed/download-permitted catalog tracks.
JAMENDO_CLIENT_ID=

# Shared secret for the trusted worker to claim, update progress, complete, and fail jobs. Never expose it to the browser.
WORKER_API_SECRET=

# Private directory shared by the Next.js server and the trusted worker (self-hosted deployments only).
AUTHORIZED_UPLOAD_DIR=/var/lib/tunefetch/uploads

# Worker-only configuration (set on the separate worker host, not in client-side variables).
WORKER_APP_URL=https://your-app.example.com
WORKER_POLL_MS=3000
# Optional executable overrides if ffmpeg/ffprobe are not on PATH.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
