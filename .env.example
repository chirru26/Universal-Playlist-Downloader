# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials.

MONGODB_URI=mongodb://127.0.0.1:27017/universal_playlist_downloader

# Optional metadata API credentials. Keep all secrets server-side.
YOUTUBE_DATA_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
\n# Secret used by a separate trusted worker to claim/heartbeat/fail jobs. Generate a random secret; never expose it to the browser.\nWORKER_API_SECRET=\n\n# Private directory shared by the Next.js server and the trusted worker (self-hosted deployments only).\nAUTHORIZED_UPLOAD_DIR=/var/lib/tunefetch/uploads\n